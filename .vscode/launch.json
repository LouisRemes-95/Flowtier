{
    "version": "1.0.0",
    "configurations": [
        {
            "name": "Debug Flowtier",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/flowtier/cli.py",
            "console": "integratedTerminal",
